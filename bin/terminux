#!/data/data/com.termux/files/usr/bin/bash
# TerminuX — Herramienta de Línea de Comandos Global

set -u

NOXMOD_HOME="$HOME/.noxmod"

find_script_base() {
    if [ -d "$NOXMOD_HOME/core" ]; then
        printf '%s' "$NOXMOD_HOME"
    else
        local src="${BASH_SOURCE[0]}"
        local dir="$(cd "$(dirname "$src")/.." && pwd)"
        printf '%s' "$dir"
    fi
}

BASE_DIR="$(find_script_base)"

if [ -f "$BASE_DIR/core/installer.sh" ]; then
    source "$BASE_DIR/core/installer.sh"
fi

show_help() {
    cat << 'EOF'
TerminuX — CLI de Personalización para Termux

Uso:
  terminux                    Abre el menú interactivo visual
  terminux menu               Abre el menú interactivo visual
  terminux theme <nombre>     Cambia el tema (yello, hack, red, space, root)
  terminux ip real            Muestra tu IP real de WiFi
  terminux ip fake <ip>       Configura una IP falsa/personalizada (0.0.0.0 - 255.255.255.255)
  terminux ip off             Oculta el segmento de la IP en el prompt
  terminux user <nombre>      Cambia el usuario del prompt
  terminux host <nombre>      Cambia el host del prompt
  terminux nano <color>       Abre o edita la configuración de Nano
  terminux restore            Restaura la configuración previa / estado de fábrica
  terminux help               Muestra esta ayuda

Temas Disponibles:
  • yello  : Tema Nightwire suave original (cian/amarillo/verde)
  • hack   : Tema Matrix Hacker (verde neón y negro)
  • red    : Tema Rojo y Negro con logo '>_' parpadeante
  • space  : Tema Azul Galáctico con estrellas ASCII en la escritura
  • root   : Réplica exacta y oficial de Kali Linux en root (bloqueado)
EOF
}

cmd="${1:-menu}"

case "$cmd" in
    menu)
        if [ -f "$BASE_DIR/core/menu.sh" ]; then
            bash "$BASE_DIR/core/menu.sh"
        elif [ -f "$NOXMOD_HOME/core/menu.sh" ]; then
            bash "$NOXMOD_HOME/core/menu.sh"
        else
            echo "Error: core/menu.sh not found."
            exit 1
        fi
        ;;
    theme)
        target_theme="${2:-}"
        if [ -z "$target_theme" ]; then
            echo "Indica un tema: yello, hack, red, space, root"
            exit 1
        fi
        switch_theme "$target_theme"
        ;;
    ip)
        mode="${2:-}"
        mkdir -p "$NOXMOD_HOME"
        case "$mode" in
            real)
                printf 'real\n' > "$NOXMOD_HOME/ip-mode"
                echo "IP configurada a: Real (WiFi)"
                ;;
            fake|custom)
                fake_ip="${3:-}"
                if [ -z "$fake_ip" ]; then
                    echo "Debes proporcionar una IP. Ej: terminux ip fake 10.10.10.1"
                    exit 1
                fi
                if validate_ipv4 "$fake_ip"; then
                    printf 'custom\n' > "$NOXMOD_HOME/ip-mode"
                    printf '%s\n' "$fake_ip" > "$NOXMOD_HOME/custom-ip"
                    echo "IP falsa configurada: $fake_ip"
                else
                    echo "Error: '$fake_ip' no es una IPv4 válida (debe ser 0.0.0.0 - 255.255.255.255)."
                    exit 1
                fi
                ;;
            off|none)
                printf 'off\n' > "$NOXMOD_HOME/ip-mode"
                echo "IP oculta en el prompt."
                ;;
            *)
                echo "Opciones de IP: real, fake <ip>, off"
                ;;
        esac
        ;;
    user)
        new_u="${2:-}"
        if [ -z "$new_u" ]; then
            echo "Uso: terminux user <nombre>"
            exit 1
        fi
        mkdir -p "$NOXMOD_HOME"
        printf '%s\n' "$new_u" > "$NOXMOD_HOME/user-name"
        echo "Usuario actualizado: $new_u"
        ;;
    host)
        new_h="${2:-}"
        if [ -z "$new_h" ]; then
            echo "Uso: terminux host <nombre>"
            exit 1
        fi
        mkdir -p "$NOXMOD_HOME"
        printf '%s\n' "$new_h" > "$NOXMOD_HOME/host-name"
        echo "Host actualizado: $new_h"
        ;;
    nano)
        if [ -f "$HOME/.nanorc" ]; then
            nano "$HOME/.nanorc"
        else
            echo "El archivo ~/.nanorc aún no existe. Instala TerminuX primero."
        fi
        ;;
    restore|reset)
        if [ -f "$BASE_DIR/core/restore.sh" ]; then
            bash "$BASE_DIR/core/restore.sh"
        elif [ -f "$NOXMOD_HOME/core/restore.sh" ]; then
            bash "$NOXMOD_HOME/core/restore.sh"
        else
            echo "Error: core/restore.sh not found."
            exit 1
        fi
        ;;
    help|--help|-h)
        show_help
        ;;
    *)
        echo "Comando no reconocido: $cmd"
        show_help
        exit 1
        ;;
esac
