#!/data/data/com.termux/files/usr/bin/bash
# TerminuX — Global Command Line Interface

set -u

TERMINUX_HOME="$HOME/.terminux"
[ ! -d "$TERMINUX_HOME" ] && [ -d "$HOME/.noxmod" ] && TERMINUX_HOME="$HOME/.noxmod"

find_script_base() {
    if [ -d "$TERMINUX_HOME/core" ]; then
        printf '%s' "$TERMINUX_HOME"
    else
        local src="${BASH_SOURCE[0]}"
        local dir="$(cd "$(dirname "$src")/.." && pwd)"
        printf '%s' "$dir"
    fi
}

BASE_DIR="$(find_script_base)"

if [ -f "$BASE_DIR/core/installer.sh" ]; then
    source "$BASE_DIR/core/installer.sh"
elif [ -f "$TERMINUX_HOME/core/installer.sh" ]; then
    source "$TERMINUX_HOME/core/installer.sh"
fi

show_help() {
    cat << 'EOF'
TerminuX — Terminal Customization CLI for Termux

Usage:
  terminux                    Launch interactive TUI menu
  terminux menu               Launch interactive TUI menu
  terminux theme <name>       Switch theme (yello, hack, red, space, root)
  terminux ip real            Display real WiFi IP in prompt
  terminux ip fake <ip>       Set custom fake IP (0.0.0.0 - 255.255.255.255)
  terminux ip off             Hide IP segment from prompt
  terminux user <name>        Change prompt username
  terminux host <name>        Change prompt hostname
  terminux nano <name>        Configure or edit Nano color schemes
  terminux restore            Restore previous backup / factory defaults
  terminux help               Show this help message

Available Themes:
  - yello  : Nightwire soft palette (cyan/yellow/green) [Default]
  - hack   : Matrix Hacker theme (phosphor green & deep black)
  - red    : Cyber Red & Black with pulsing '>_' terminal logo
  - space  : Deep Cosmic Blue with subtle ASCII stars
  - root   : Exact Kali Linux root replica (locked)
EOF
}

cmd="${1:-menu}"

case "$cmd" in
    menu)
        if [ -f "$BASE_DIR/core/menu.sh" ]; then
            bash "$BASE_DIR/core/menu.sh"
        elif [ -f "$TERMINUX_HOME/core/menu.sh" ]; then
            bash "$TERMINUX_HOME/core/menu.sh"
        else
            echo "Error: core/menu.sh not found."
            exit 1
        fi
        ;;
    theme)
        target_theme="${2:-}"
        if [ -z "$target_theme" ]; then
            echo "Please specify a theme: yello, hack, red, space, root"
            exit 1
        fi
        switch_theme "$target_theme"
        ;;
    ip)
        mode="${2:-}"
        mkdir -p "$TERMINUX_HOME"
        case "$mode" in
            real)
                printf 'real\n' > "$TERMINUX_HOME/ip-mode"
                echo "IP mode set to: Real (WiFi)"
                ;;
            fake|custom)
                fake_ip="${3:-}"
                if [ -z "$fake_ip" ]; then
                    echo "Please provide an IP address. Example: terminux ip fake 10.10.10.1"
                    exit 1
                fi
                if validate_ipv4 "$fake_ip"; then
                    printf 'custom\n' > "$TERMINUX_HOME/ip-mode"
                    printf '%s\n' "$fake_ip" > "$TERMINUX_HOME/custom-ip"
                    echo "Custom IP configured: $fake_ip"
                else
                    echo "Error: '$fake_ip' is not a valid IPv4 address (must be 0.0.0.0 - 255.255.255.255)."
                    exit 1
                fi
                ;;
            off|none)
                printf 'off\n' > "$TERMINUX_HOME/ip-mode"
                echo "IP segment disabled in prompt."
                ;;
            *)
                echo "IP Options: real, fake <ip>, off"
                ;;
        esac
        ;;
    user)
        new_u="${2:-}"
        new_u="$(echo "$new_u" | tr -d '\r\n ')"
        if [ -z "$new_u" ]; then
            echo "Usage: terminux user <name>"
            exit 1
        fi
        mkdir -p "$TERMINUX_HOME"
        printf '%s\n' "$new_u" > "$TERMINUX_HOME/user-name"
        echo "Username updated to: $new_u"
        ;;
    host)
        new_h="${2:-}"
        new_h="$(echo "$new_h" | tr -d '\r\n ')"
        if [ -z "$new_h" ]; then
            echo "Usage: terminux host <name>"
            exit 1
        fi
        mkdir -p "$TERMINUX_HOME"
        printf '%s\n' "$new_h" > "$TERMINUX_HOME/host-name"
        echo "Hostname updated to: $new_h"
        ;;
    nano)
        if [ -f "$HOME/.nanorc" ]; then
            nano "$HOME/.nanorc"
        else
            echo "File ~/.nanorc does not exist. Run TerminuX installer first."
        fi
        ;;
    restore|reset)
        if [ -f "$BASE_DIR/core/restore.sh" ]; then
            bash "$BASE_DIR/core/restore.sh"
        elif [ -f "$TERMINUX_HOME/core/restore.sh" ]; then
            bash "$TERMINUX_HOME/core/restore.sh"
        else
            echo "Error: core/restore.sh not found."
            exit 1
        fi
        ;;
    help|--help|-h)
        show_help
        ;;
    *)
        echo "Unknown command: $cmd"
        show_help
        exit 1
        ;;
esac

